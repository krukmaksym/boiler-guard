#!/usr/bin/env python3
"""Block commits that would publish secrets.

1. Refuses secret files (.prod.vars, .dev.vars, .test.vars, .env*, .wrangler/) outright.
2. Refuses staged content containing any real value from .prod.vars / .dev.vars / .test.vars.
3. Refuses staged content that looks like a JWT or a Shelly/Deye credential assignment.

Enabled with: git config core.hooksPath scripts/hooks
With --all it scans every tracked file instead of the staged ones (used by CI).
Never prints the matched secret, only the file and the variable name.
"""

import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip())
sys.path.insert(0, str(ROOT / "scripts"))

BLOCKED = re.compile(r"(^|/)(\.prod\.vars|\.dev\.vars|\.test\.vars|\.env)(\..*)?$|(^|/)\.wrangler/")
ALLOWED = {".prod.vars.example", ".test.vars.example"}
PATTERNS = {
    "JWT": re.compile(rb"eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}"),
    "credential assignment": re.compile(
        rb"(APP_SECRET|SHELLY_AUTH_KEY|SHA_256_PASSWORD|BEARER_TOKEN|TELEGRAM_WEBHOOK_SECRET)\s*=\s*[\"']?[A-Za-z0-9+/=_-]{16,}"
    ),
    "Telegram bot token": re.compile(rb"\b\d{8,10}:[A-Za-z0-9_-]{35}\b"),
}


def real_values():
    values = {}
    for name in (".prod.vars", ".dev.vars", ".test.vars"):
        path = ROOT / name
        if not path.exists():
            continue
        for line in path.read_text().splitlines():
            m = re.match(r"^\s*([A-Z0-9_]+)\s*=\s*(.*?)\s*$", line)
            if m:
                key, value = m.groups()
                value = value.strip("\"'")
                if len(value) >= 6:
                    values.setdefault(value, key)
    return values


def main():
    scan_all = "--all" in sys.argv[1:]
    if scan_all:
        listing = ["git", "ls-files", "-z"]
    else:
        listing = ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z"]
    files = [f for f in subprocess.check_output(listing).decode().split("\0") if f]
    values = real_values()
    problems = []
    for f in files:
        if f not in ALLOWED and BLOCKED.search(f):
            problems.append(f"{f}: secret file must never be committed")
            continue
        if scan_all:
            blob = (ROOT / f).read_bytes()
        else:
            blob = subprocess.run(["git", "show", f":{f}"], capture_output=True).stdout
        for value, key in values.items():
            if value.encode() in blob:
                problems.append(f"{f}: contains the real value of {key}")
        if f != "scripts/hooks/pre-commit":
            for label, pattern in PATTERNS.items():
                if pattern.search(blob):
                    problems.append(f"{f}: looks like a {label}")
    if problems:
        print("pre-commit: refusing to commit possible secrets:", file=sys.stderr)
        for p in problems:
            print(f"  - {p}", file=sys.stderr)
        return 1
    if scan_all:
        print(f"secret scan: {len(files)} tracked files clean")
    return 0


if __name__ == "__main__":
    sys.exit(main())
